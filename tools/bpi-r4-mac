#!/usr/bin/python3 -I
# Show or set the BPI-R4 base MAC address in the on-board 24c02 EEPROM.
#
# The record layout is shared with EDK2 (BpiR4MacLib.h):
#   0x00-0x05  base MAC
#   0x06       layout version (1)
#   0x07       flags, bit 0: generated by firmware
#   0x08-0x0B  magic "R4MA"
#   0x0C-0x0F  CRC32 (little-endian) over 0x00-0x0B
#
# EDK2 reads it at every boot and puts base+N into the device tree; a blank
# record (all 0xff) makes it generate and store a random base. Changes take
# effect on the next boot. Needs root to write.

import glob
import os
import struct
import sys
import zlib

MAGIC = b'R4MA'
VERSION = 1
FLAG_GENERATED = 0x01
RECORD_LEN = 16
PORTS = ['gmac0, switch conduit', 'wan', 'lan1', 'lan2', 'lan3', 'gmac1, SFP', 'gmac2, SFP']


def find_nvmem():
    # at24 exposes the EEPROM as <bus>-0057<n>; match the DT node to be sure
    for path in glob.glob('/sys/bus/nvmem/devices/*-0057*'):
        node = os.path.realpath(os.path.join(path, 'of_node'))
        if node.endswith('/eeprom@57'):
            return os.path.join(path, 'nvmem')
    sys.exit('EEPROM eeprom@57 not found under /sys/bus/nvmem/devices')


def fmt(mac):
    return ':'.join(f'{b:02x}' for b in mac)


def parse(text):
    parts = text.replace('-', ':').split(':')
    if len(parts) != 6 or not all(len(p) == 2 for p in parts):
        sys.exit(f'not a MAC address: {text}')
    try:
        mac = bytes(int(p, 16) for p in parts)
    except ValueError:
        sys.exit(f'not a MAC address: {text}')
    if mac[0] & 0x01:
        sys.exit('rejected: multicast address')
    if mac == bytes(6):
        sys.exit('rejected: all-zero address')
    return mac


def port_mac(base, index):
    value = int.from_bytes(base, 'big') + index
    return (value & 0xFFFFFFFFFFFF).to_bytes(6, 'big')


def read_record(nvmem):
    with open(nvmem, 'rb') as f:
        return f.read(RECORD_LEN)


def write_record(nvmem, data):
    with open(nvmem, 'r+b') as f:
        f.write(data)
    if read_record(nvmem) != data:
        sys.exit('read-back mismatch, EEPROM write failed')


def build_record(mac):
    head = mac + bytes([VERSION, 0]) + MAGIC
    return head + struct.pack('<I', zlib.crc32(head))


def show(nvmem):
    rec = read_record(nvmem)
    if rec == b'\xff' * RECORD_LEN:
        print('No MAC stored: firmware generates one on the next boot')
        return
    head, crc = rec[:12], struct.unpack('<I', rec[12:])[0]
    if head[8:12] != MAGIC or head[6] != VERSION or zlib.crc32(head) != crc:
        print('EEPROM holds an unknown record, firmware uses a random MAC each boot')
        print('Use "set" or "clear" to replace it')
        return
    base = head[:6]
    source = 'generated' if head[7] & FLAG_GENERATED else 'set by user'
    print(f'Base MAC: {fmt(base)} ({source})')
    for index, name in enumerate(PORTS):
        print(f'  {fmt(port_mac(base, index))}  {name}')


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('show', 'set', 'clear'):
        sys.exit(f'usage: {sys.argv[0]} show | set <xx:xx:xx:xx:xx:xx> | clear')
    nvmem = find_nvmem()
    cmd = sys.argv[1]
    if cmd == 'show':
        show(nvmem)
    elif cmd == 'set':
        if len(sys.argv) != 3:
            sys.exit(f'usage: {sys.argv[0]} set <xx:xx:xx:xx:xx:xx>')
        mac = parse(sys.argv[2])
        write_record(nvmem, build_record(mac))
        if mac[5] & 0x07:
            print('Note: base is not 8-aligned, port addresses carry into the upper bytes')
        print('Stored, used from the next boot')
        show(nvmem)
    else:
        write_record(nvmem, b'\xff' * RECORD_LEN)
        print('Erased, firmware generates a new base MAC on the next boot')


if __name__ == '__main__':
    main()
