  MdePkg/MdePkg.dec
  Silicon/MediaTek/MT7988Pkg/MT7988Pkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  DevicePathLib
  IoLib
  MT7988BootMediumLib
